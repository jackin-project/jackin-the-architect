{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 20,
  "ignorePaths": [
    ".github/**",
    "toolchain/mise.toml",
    ".mise/locks/**",
    "toolchain/.mise/locks/**"
  ],
  "commitBody": "Signed-off-by: Renovate Bot <renovate@whitesourcesoftware.com>",
  "customDatasources": {
    "git-source": {
      "defaultRegistryUrlTemplate": "https://mirrors.edge.kernel.org/pub/software/scm/git/sha256sums.asc",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": releases[$contains(version, /^[a-f0-9]{64}\\s+git-\\d+\\.\\d+\\.\\d+\\.tar\\.xz$/)].{\"version\": $match(version, /git-(\\d+\\.\\d+\\.\\d+)\\.tar\\.xz$/).groups[0], \"digest\": $substring(version, 0, 64)}}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG MISE_VERSION=(?<currentValue>\\S+)\\nARG MISE_SHASUMS256=(?<currentDigest>[a-f0-9]{64})\\n"
      ],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG GIT_VERSION=(?<currentValue>\\S+)\\nARG GIT_SHA256=(?<currentDigest>[a-f0-9]{64})\\n"
      ],
      "depNameTemplate": "git",
      "datasourceTemplate": "custom.git-source"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG RUSTUP_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "rust-lang/rustup",
      "datasourceTemplate": "github-tags"
    }
  ]
}
